# Supabase — Dashboard → Connect. Use the pooler hosts (IPv4); the direct db.<ref>.supabase.co host is IPv6-only.

# Runtime (Next.js / Vercel serverless, via @prisma/adapter-pg): transaction pooler, port 6543.
# uselibpqcompat=true makes node-postgres treat sslmode=require as "encrypt" (libpq semantics).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"

# Migrations (prisma migrate): session pooler, port 5432
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
